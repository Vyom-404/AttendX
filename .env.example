MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/attendx?appName=Cluster0
PORT=3000
API_HOST=127.0.0.1
# Add local web app origins if their hosts or ports change.
WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173
FACE_SERVICE_URL=http://127.0.0.1:8000
NODE_ENV=development
ENABLE_DEV_LOGIN=false
DEV_LOGIN_SECRET=replace_with_a_private_development_secret
AUTH_TOKEN_SECRET=replace_with_a_random_secret_at_least_32_characters_long
AUTH_TOKEN_LIFETIME_SECONDS=604800
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-service-account-private-key\n-----END PRIVATE KEY-----\n"
DEFAULT_HOSTEL_ID=hostel_demo
HOSTEL_ID=hostel_demo
HOSTEL_NAME=Set_me_in_local_env
HOSTEL_CENTER_LAT=SET_ME
HOSTEL_CENTER_LON=SET_ME
HOSTEL_RADIUS_METERS=SET_ME
HOSTEL_MAX_ACCURACY_METERS=SET_ME
HOSTEL_MAX_FIX_AGE_SECONDS=SET_ME
FACE_MATCH_THRESHOLD=0.70
